{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sdd-session-title.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sdd-summary.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.claude/worktrees/**)",
      "Edit(./.claude/worktrees/**)",
      "Write(./.claude/worktrees/**)"
    ]
  }
}
